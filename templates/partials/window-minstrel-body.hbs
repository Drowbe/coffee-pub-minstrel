                        <span class="minstrel-field-label">Track</span>
                        <select id="cue-track">
                            <option value="">Select a track</option>
                            {{#each cueTrackOptions}}
                            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                            {{/each}}
                        </select>
                    </label>
                    <div class="minstrel-field minstrel-cue-field-volume">
                        <span class="minstrel-field-label">Volume</span>
                        <label class="minstrel-layer-slider" title="Volume" aria-label="Volume">
                            <i class="fa-solid fa-volume-high"></i>
                            <input type="range" id="cue-volume" min="0" max="100" step="1" value="{{selectedCueVolumePercent}}" />
                            <span>{{selectedCueVolumePercent}}%</span>
                        </label>
                    </div>
                    <label class="minstrel-field minstrel-cue-field-cooldown">
                        <span class="minstrel-field-label">Cooldown</span>
                        <input type="number" id="cue-cooldown" min="0" max="120" step="1" value="{{selectedCue.cooldown}}" />
                    </label>
                </div>
            </div>
        </article>
        {{/if}}
    </section>
    {{/if}}

    {{#if isAutomation}}
    <section class="minstrel-cues-workspace minstrel-automation-workspace">
        <article class="minstrel-panel-card minstrel-cues-browser-column">
            <header class="minstrel-section-header">
                <h3 class="minstrel-section-title" data-tooltip="Rule order in this list is only for browsing (categories and names). When several rules match the same event, Minstrel ranks them using the Order of operations described on the Rule Editor title—not by this list." data-tooltip-direction="UP">Automation Rules</h3>
                <button type="button" class="minstrel-icon-action" data-action="newRule" title="New Rule" aria-label="New Rule"><i class="fa-solid fa-plus"></i></button>
            </header>
            <div class="minstrel-column-list">
                {{#each ruleGroups}}
                <section class="minstrel-cue-group">
                    <h4 class="minstrel-section-title">{{this.name}}</h4>
                    <div class="minstrel-cue-grid">
                        {{#each this.rules}}
                        <div class="minstrel-list-row minstrel-automation-card minstrel-cue-browser-card minstrel-automation-browser-card {{#if this.isSelected}}is-selected{{/if}} {{#unless this.ruleEnabled}}is-rule-disabled{{/unless}}" style="{{this.cardStyle}}" data-action="selectRule" data-value="{{this.id}}" role="button" tabindex="0">
                            <div class="minstrel-cue-editor-icon" {{#if this.tintColor}}style="background: {{this.tintColor}};"{{/if}}>
                                <i class="{{this.icon}}"></i>
                            </div>
                            <div class="minstrel-cue-card-copy">
                                <div class="minstrel-list-title">{{this.name}}</div>
                                <div class="minstrel-list-meta">{{#unless this.ruleEnabled}}<span class="minstrel-automation-rule-off-label">Off</span> · {{/unless}}{{this.eventLabel}} · {{this.importanceLabel}} Priority</div>
                            </div>
                            <button type="button" class="minstrel-icon-action minstrel-automation-rule-card-favorite {{#if this.favorite}}is-active{{/if}}" data-action="toggleFavoriteAutomationRule" data-value="{{this.id}}" title="{{#if this.favorite}}Unfavorite rule{{else}}Favorite for menubar{{/if}}" aria-label="{{#if this.favorite}}Unfavorite automation rule{{else}}Favorite automation rule{{/if}}"><i class="fa-solid fa-heart"></i></button>
                            <button type="button" class="minstrel-icon-action minstrel-automation-rule-card-power {{#if this.ruleEnabled}}is-active{{/if}}" data-action="toggleAutomationRuleEnabled" data-value="{{this.id}}" title="{{#if this.ruleEnabled}}Disable rule{{else}}Enable rule{{/if}}" aria-label="{{#if this.ruleEnabled}}Disable automation rule{{else}}Enable automation rule{{/if}}"><i class="fa-solid fa-power-off"></i></button>
                            <button type="button" class="minstrel-icon-action minstrel-cue-card-edit minstrel-automation-rule-card-edit {{#if this.isSelected}}is-active{{/if}}" data-action="selectRule" data-value="{{this.id}}" title="Edit rule" aria-label="Edit automation rule"><i class="fa-solid fa-feather-pointed"></i></button>
                        </div>
                        {{/each}}
                    </div>
                </section>
                {{else}}
                <p class="minstrel-empty">No automation rules saved yet.</p>
                {{/each}}
            </div>
        </article>

        <article class="minstrel-panel-card minstrel-cue-editor-column">
            <header class="minstrel-section-header">
                <h3 class="minstrel-section-title" data-tooltip="Within this rule: any trigger matches (OR). Every condition group must pass (AND between groups). Inside a group, combine rows left to right using the AND, OR, and NOT controls between rows. When several rules match at once, Minstrel picks a tier first: High importance runs before any Normal, Normal before any Low. Within one tier it ranks by: (1) most individual condition rows true right now, (2) if tied, specificity by clause types, (3) rule name A to Z. The first rule in that order whose action succeeds wins. A deliberate no-op success still stops other rules from running." data-tooltip-direction="UP">Rule Editor</h3>
                <div class="minstrel-row-actions">
                    <label class="minstrel-icon-toggle" title="Restore previous audio on combat end">
                        <input type="checkbox" id="rule-restore" {{#if selectedRule.restorePreviousOnExit}}checked{{/if}} />
                        <i class="fa-solid fa-rotate-left"></i>
                    </label>
                    <label class="minstrel-icon-toggle" title="Rule enabled">
                        <input type="checkbox" id="rule-enabled" {{#if selectedRule.enabled}}checked{{/if}} />
                        <i class="fa-solid fa-power-off"></i>
                    </label>
                    <label class="minstrel-icon-toggle" title="Favorite for menubar quick menu">
                        <input type="checkbox" id="rule-favorite" {{#if selectedRule.favorite}}checked{{/if}} />
                        <i class="fa-solid fa-heart"></i>
                    </label>
                    <button type="button" class="minstrel-icon-action" data-action="duplicateRule" title="Duplicate Rule" aria-label="Duplicate Rule"><i class="fa-solid fa-copy"></i></button>
                    <button type="button" class="minstrel-icon-action" data-action="saveRule" title="Save Rule" aria-label="Save Rule"><i class="fa-solid fa-floppy-disk"></i></button>
                    <button type="button" class="minstrel-icon-action" data-action="runRule" title="Run Rule" aria-label="Run Rule"><i class="fa-solid fa-play"></i></button>
                    <button type="button" class="minstrel-icon-action minstrel-icon-action-danger" data-action="deleteRule" title="Delete Rule" aria-label="Delete Rule"><i class="fa-solid fa-trash"></i></button>
                </div>
            </header>
            <div class="minstrel-column-list">
                <div class="minstrel-cue-editor-shell">
                    <div class="minstrel-cue-editor-hero minstrel-automation-editor-hero">
                        <div class="minstrel-cue-editor-icon" {{#if selectedRule.tintColor}}style="background: {{selectedRule.tintColor}};"{{/if}}>
                            <i class="{{selectedRule.icon}}"></i>
                        </div>
                        <div class="minstrel-cue-editor-copy">
                            <div class="minstrel-list-title">{{#if selectedRule.name}}{{selectedRule.name}}{{else}}Create New Rule{{/if}}</div>
                            <div class="minstrel-list-meta">{{#if selectedRule.name}}{{triggerSummaryCount}} triggers · {{conditionSummaryCount}} conditions{{else}}Configure the automation below, then save it.{{/if}}</div>
                        </div>
                    </div>
                    <div class="minstrel-form-grid minstrel-cue-form-grid minstrel-automation-core-grid">
                        <label class="minstrel-field minstrel-form-span-2">
                            <span class="minstrel-field-label">Rule Name</span>
                            <input type="text" id="rule-name" value="{{selectedRule.name}}" />
                        </label>
                        <label class="minstrel-field minstrel-form-span-2">
                            <span class="minstrel-field-label">Category</span>
                            <select id="rule-category">
                                {{#each ruleCategoryOptions}}
                                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}} {{#if this.disabled}}disabled{{/if}}>{{this.label}}</option>
                                {{/each}}
                            </select>
                        </label>
                        {{#if selectedRuleCategoryIsCreateNew}}
                        <label class="minstrel-field minstrel-form-span-2">
                            <span class="minstrel-field-label">New Category</span>
                            <input type="text" id="rule-category-new" value="{{selectedRule.category}}" placeholder="Enter a category name" />
                        </label>
                        {{/if}}
                        <label class="minstrel-field">
                            <span class="minstrel-field-label">Icon</span>
                            <input type="text" id="rule-icon" value="{{selectedRule.icon}}" placeholder="fa-solid fa-diagram-project" />
                        </label>
                        <label class="minstrel-field">
                            <span class="minstrel-field-label">Tint</span>
                            <input type="color" id="rule-tint-color" value="{{selectedRule.tintColor}}" />
                        </label>
                        <label class="minstrel-field">
                            <span class="minstrel-field-label">Importance</span>
                            <select id="rule-importance">
                                {{#each ruleImportanceOptions}}
                                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                                {{/each}}
                            </select>
                        </label>
                        <label class="minstrel-field">
                            <span class="minstrel-field-label">Delay (ms)</span>
                            <input type="number" id="rule-delay-ms" min="0" max="30000" step="250" value="{{selectedRule.delayMs}}" />
                        </label>
                    </div>

                    <section class="minstrel-automation-rules">
                        <header class="minstrel-section-header">
                            <h4 class="minstrel-section-title">Action to Take</h4>
                        </header>
                        <div class="minstrel-form-grid minstrel-cue-form-grid minstrel-automation-core-grid">
                            <label class="minstrel-field minstrel-form-span-2">
                                <span class="minstrel-field-label">Action</span>
                                <select id="rule-action">
                                    {{#each ruleActionOptions}}
                                    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                                    {{/each}}
                                </select>
                            </label>
                            <label class="minstrel-field minstrel-form-span-2">
                                <span class="minstrel-field-label">Sound Scene</span>
                                <select id="rule-sound-scene">
                                    {{#each ruleSoundSceneOptions}}
                                    <option value="{{this.id}}" {{#if this.selected}}selected{{/if}} {{#if this.disabled}}disabled{{/if}}>{{this.name}}</option>
                                    {{/each}}
                                </select>
                            </label>
                        </div>
                    </section>

                    <section class="minstrel-automation-rules minstrel-automation-triggers-section">
                        <header class="minstrel-section-header">
                            <h4 class="minstrel-section-title" data-tooltip="If any trigger matches the current event, Minstrel evaluates the conditions below. Which scene (exact document or name match) belongs under Conditions, not on the scene trigger row." data-tooltip-direction="UP">Triggers</h4>
                        </header>
                        <div class="minstrel-row-actions minstrel-automation-add-row">
                            <select id="automation-trigger-type" class="minstrel-automation-rule-select">
                                {{#each automationTriggerTypeOptions}}
                                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}} {{#if this.disabled}}disabled{{/if}}>{{this.label}}</option>
                                {{/each}}
                            </select>
                            <button type="button" class="minstrel-icon-action" data-action="addAutomationTrigger" title="Add Trigger" aria-label="Add Trigger"><i class="fa-solid fa-plus"></i></button>
                        </div>
                        <div class="minstrel-automation-rule-stack minstrel-automation-trigger-stack">
                            {{#each automationTriggers}}
                            {{#unless this.isFirst}}
                            <div class="minstrel-automation-or-banner" aria-hidden="true">OR</div>
                            {{/unless}}
                            <article class="minstrel-layer-card minstrel-automation-rule-card {{this.cardToneClass}}" data-automation-trigger-row data-clause-id="{{this.id}}" data-clause-type="{{this.type}}">
                                <div class="minstrel-automation-rule-header">
                                    <div class="minstrel-row-actions">
                                        <button type="button" class="minstrel-icon-action" data-action="moveAutomationTriggerUp" data-value="{{this.id}}" title="Move Up" aria-label="Move Up" {{#if this.isFirst}}disabled{{/if}}><i class="fa-solid fa-chevron-up"></i></button>
                                        <button type="button" class="minstrel-icon-action" data-action="moveAutomationTriggerDown" data-value="{{this.id}}" title="Move Down" aria-label="Move Down" {{#if this.isLast}}disabled{{/if}}><i class="fa-solid fa-chevron-down"></i></button>
                                    </div>
                                    <div class="minstrel-list-title" {{#if this.triggerHintText}}data-tooltip="{{this.triggerHintText}}" data-tooltip-direction="UP"{{/if}}>{{this.typeLabel}}</div>
                                    <button type="button" class="minstrel-icon-action minstrel-icon-action-danger" data-action="removeAutomationTrigger" data-value="{{this.id}}" title="Remove Trigger" aria-label="Remove Trigger"><i class="fa-solid fa-trash"></i></button>
                                </div>
                                {{#if this.showPhase}}
                                <select data-automation-field="phase">
                                    {{#each this.phaseOptions}}
                                    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                                    {{/each}}
                                </select>
                                {{/if}}
                            </article>
                            {{else}}
                            <p class="minstrel-empty">Add at least one trigger (e.g. Scene Start or World Time).</p>
                            {{/each}}
                        </div>
                    </section>

                    <section class="minstrel-automation-rules minstrel-automation-conditions-section">
                        <header class="minstrel-section-header minstrel-automation-conditions-header">
                            <h4 class="minstrel-section-title" data-tooltip="Every group must pass (AND between groups). Inside a group, use the AND, OR, or NOT control between rows to say how each new condition combines with the ones above." data-tooltip-direction="UP">Conditions</h4>
                            <button type="button" class="minstrel-btn minstrel-btn-secondary minstrel-automation-add-group-btn" data-action="addAutomationConditionGroup" title="Add condition group">Add Group</button>
                        </header>
                        {{#each automationConditionGroups}}
                        {{#unless this.isFirstGroup}}
                        <div class="minstrel-automation-and-banner" aria-hidden="true">AND</div>
                        {{/unless}}
                        <div class="minstrel-automation-condition-group" data-automation-condition-group data-automation-group-id="{{this.id}}">
                            <div class="minstrel-automation-condition-group-header">
                                <span class="minstrel-automation-condition-group-title">{{this.groupLabel}}</span>
                                {{#if this.canRemoveGroup}}
                                <div class="minstrel-automation-condition-group-header-actions">
                                    <button type="button" class="minstrel-icon-action minstrel-icon-action-danger" data-action="removeAutomationConditionGroup" data-group-id="{{this.id}}" title="Remove group" aria-label="Remove group"><i class="fa-solid fa-trash"></i></button>
                                </div>
                                {{/if}}
                            </div>
                            <div class="minstrel-row-actions minstrel-automation-add-row">
                                <select class="minstrel-automation-rule-select" data-automation-condition-type-select="{{this.id}}">
                                    {{#each ../automationConditionTypeOptions}}
                                    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}} {{#if this.disabled}}disabled{{/if}}>{{this.label}}</option>
                                    {{/each}}
                                </select>
                                <button type="button" class="minstrel-icon-action" data-action="addAutomationConditionClause" data-group-id="{{this.id}}" title="Add condition" aria-label="Add condition"><i class="fa-solid fa-plus"></i></button>
                            </div>
                            <div class="minstrel-automation-rule-stack minstrel-automation-condition-clause-stack">
                                {{#each this.clauses}}
                                {{#unless this.isFirst}}
                                <div class="minstrel-automation-operator-card">
                                    <select data-automation-field="join">
                                        {{#each this.joinOptions}}
                                        <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                                        {{/each}}
                                    </select>
                                </div>
                                {{/unless}}
                                <article class="minstrel-layer-card minstrel-automation-rule-card {{this.cardToneClass}}" data-automation-clause-row data-clause-id="{{this.id}}" data-clause-type="{{this.type}}">
                                    <div class="minstrel-automation-rule-header">
                                        <div class="minstrel-row-actions">
                                            <button type="button" class="minstrel-icon-action" data-action="moveAutomationClauseUp" data-value="{{this.id}}" data-group-id="{{../id}}" title="Move Up" aria-label="Move Up" {{#if this.isFirst}}disabled{{/if}}><i class="fa-solid fa-chevron-up"></i></button>
                                            <button type="button" class="minstrel-icon-action" data-action="moveAutomationClauseDown" data-value="{{this.id}}" data-group-id="{{../id}}" title="Move Down" aria-label="Move Down" {{#if this.isLast}}disabled{{/if}}><i class="fa-solid fa-chevron-down"></i></button>
                                        </div>
                                        <div class="minstrel-list-title" {{#if this.showHabitat}}data-tooltip="Habitat conditions use the habitats configured on the active scene." data-tooltip-direction="UP"{{/if}}>{{this.typeLabel}}</div>
                                        <button type="button" class="minstrel-icon-action minstrel-icon-action-danger" data-action="removeAutomationClause" data-value="{{this.id}}" data-group-id="{{../id}}" title="Remove condition" aria-label="Remove condition"><i class="fa-solid fa-trash"></i></button>
                                    </div>
                                    {{#if this.showScene}}
                                    <select data-automation-field="sceneId">
                                        <option value="">Any Scene</option>
                                        {{#each this.sceneOptions}}
                                        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
                                        {{/each}}
                                    </select>
                                    {{/if}}
                                    {{#if this.showSceneNameContains}}
                                    <input type="text" value="{{this.sceneNameContains}}" data-automation-field="sceneNameContains" placeholder="Scene name contains..." />
                                    {{/if}}
                                    {{#if this.showHabitat}}
                                    <select data-automation-field="habitat">
                                        <option value="">Any Habitat</option>
                                        {{#each this.habitatOptions}}
                                        <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                                        {{/each}}
                                    </select>
                                    {{/if}}
                                    {{#if this.showTimeOfDay}}
                                    <div class="minstrel-automation-time-range" style="{{this.timeRangeStyle}}">
                                        <div class="minstrel-automation-time-slider-row">
                                            <div class="minstrel-automation-time-rail" aria-hidden="true">
                                                <span class="minstrel-automation-time-track"></span>
                                                <span class="minstrel-automation-time-window"></span>
                                            </div>
                                            <input type="range" class="minstrel-automation-time-handle minstrel-automation-time-handle-start" min="0" max="1439" step="15" value="{{this.timeStartMinutes}}" data-automation-field="timeStartMinutes" aria-label="Time range start" />
                                            <input type="range" class="minstrel-automation-time-handle minstrel-automation-time-handle-end" min="0" max="1440" step="15" value="{{this.timeEndMinutes}}" data-automation-field="timeEndMinutes" aria-label="Time range end" />
                                        </div>
                                        <div class="minstrel-list-meta minstrel-automation-time-value" data-automation-time-value>{{this.timeLabel}}</div>
                                    </div>
                                    {{/if}}
                                    {{#if this.showDate}}
                                    <div class="minstrel-automation-date-grid">
                                        <input type="number" value="{{this.dateYear}}" data-automation-field="dateYear" placeholder="Year" />
                                        <select data-automation-field="dateMonth">
                                            {{#each this.dateMonthOptions}}
                                            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                                            {{/each}}
                                        </select>
                                        <input type="number" value="{{this.dateDay}}" data-automation-field="dateDay" min="1" max="31" placeholder="Day" />
                                    </div>
                                    {{/if}}
                                </article>
                                {{else}}
                                <p class="minstrel-empty">No conditions in this group — it always passes.</p>
                                {{/each}}
                            </div>
                        </div>
                        {{/each}}
                    </section>
                    <footer class="minstrel-automation-editor-footer">
                        <button type="button" class="minstrel-btn minstrel-automation-save-rule-btn {{#if automationRuleDirty}}is-dirty{{else}}is-clean{{/if}}" data-action="saveRule" data-automation-save-rule title="Save this automation rule" aria-label="Save rule"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i><span>Save Rule</span></button>
                    </footer>
                </div>
            </div>
        </article>
    </section>
    {{/if}}
</div>
