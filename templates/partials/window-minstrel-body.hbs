                            <button type="button" class="minstrel-icon-action minstrel-cue-card-edit {{#if this.isEditing}}is-active{{/if}}" data-action="selectCue" data-value="{{this.id}}" title="Edit Cue" aria-label="Edit Cue"><i class="fa-solid fa-feather-pointed"></i></button>
